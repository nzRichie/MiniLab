#!/bin/sh
# Serve a fixed identity line on 0.0.0.0:80. The identity is the sole argument, so
# the victim and the attacker each name themselves; there is no default. Used as
# the data-plane oracle: a captured client's `curl 1.0.0.1` prints whichever host
# is answering, so a hijack is visible as the banner flipping from the victim's to
# the attacker's.
[ -n "$1" ] || { echo "usage: banner-server <identity-string>" >&2; exit 1; }
exec python3 -c '
import http.server, socketserver, sys
msg = (sys.argv[1] + "\n").encode()
class H(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(msg)))
        self.end_headers()
        self.wfile.write(msg)
    def log_message(self, *a):
        pass
socketserver.TCPServer.allow_reuse_address = True
socketserver.TCPServer(("0.0.0.0", 80), H).serve_forever()
' "$1"
