#!/bin/sh
# Serve a fixed identity line on port 80, over both IPv4 and IPv6. The identity
# is the sole argument, so each machine names itself and there is no default.
#
# This is the lab's one non-DNS oracle: the client resolves a name, connects to
# whatever address came back, and prints which machine answered. A name that
# resolves and a name that reaches the intended machine are different claims, and
# this is what separates them.
#
# The socket is opened on :: with IPV6_V6ONLY cleared, so one listener answers a
# connection to the A record's address and to the AAAA record's address alike.
# That matters here: www.uni.lab carries both, and curl prefers the AAAA, so a
# v4-only listener would make the same URL succeed or fail depending on which
# record the client happened to use.
[ -n "$1" ] || { echo "usage: banner-server <identity-string>" >&2; exit 1; }
exec python3 -c '
import http.server, socket, socketserver, sys
msg = (sys.argv[1] + "\n").encode()

class H(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(msg)))
        self.end_headers()
        self.wfile.write(msg)
    def log_message(self, *a):
        pass

class S(socketserver.TCPServer):
    address_family = socket.AF_INET6
    allow_reuse_address = True
    def server_bind(self):
        self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
        socketserver.TCPServer.server_bind(self)

S(("::", 80), H).serve_forever()
' "$1"
