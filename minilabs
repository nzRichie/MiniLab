#!/usr/bin/env bash
# MiniLabs launcher. Its job is to start the engine from the release root,
# because the engine loads ./config.toml from its working directory and resolves
# the menu's script paths against that same directory.
#
# It does not elevate and does not need to. Spawn does its veth and network
# namespace plumbing inside a short-lived privileged container, so membership of
# the `docker` group is the only privilege a learner needs.
# Run it from anywhere: ./minilabs, or /path/to/MiniLabs/minilabs.
set -euo pipefail

ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
cd "$ROOT"

[ -x ./minimanager ] || { echo "minimanager is missing from $ROOT" >&2; exit 1; }
[ -f ./config.toml ] || { echo "config.toml is missing from $ROOT" >&2; exit 1; }

if ! docker info >/dev/null 2>&1; then
    echo "Cannot reach the Docker daemon. Start it and check your access:" >&2
    echo "    rootless:  systemctl --user start docker" >&2
    echo "    rootful:   sudo systemctl start docker" >&2
    echo "               sudo usermod -aG docker \"\$USER\"    # then log out and back in" >&2
    exit 1
fi

exec ./minimanager
